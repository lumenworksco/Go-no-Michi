{
  "name": "go-no-michi",
  "private": true,
  "version": "0.1.0",
  "description": "ごのみち (Go no Michi): a Go (囲碁) PWA with a built-in AI, tsumego puzzles and a hiragana/katakana-only Japanese UI",
  "keywords": [
    "go",
    "igo",
    "baduk",
    "weiqi",
    "pwa",
    "react",
    "vite",
    "tsumego",
    "japanese"
  ],
  "homepage": "https://go.braunf.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumenworksco/Go-no-Michi.git"
  },
  "bugs": {
    "url": "https://github.com/lumenworksco/Go-no-Michi/issues"
  },
  "author": "Florian Braun",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "e2e:live": "playwright test --project=desktop-chromium --project=mobile-webkit",
    "arena": "tsx scripts/arena.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.2",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
